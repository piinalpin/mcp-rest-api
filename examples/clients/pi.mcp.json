{
  "mcpServers": {
    "rest-api": {
      "command": "npx",
      "args": ["-y", "@piinalpin/mcp-rest-api"],
      "env": {
        "BASE_URL": "https://api.example.com/v1",
        "AUTH_BEARER": "${AUTH_BEARER}",
        "HEADER_Accept": "application/json"
      },
      "exposure": "direct"
    }
  }
}
