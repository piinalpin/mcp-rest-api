{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rest-api": {
      "type": "local",
      "command": ["npx", "-y", "@piinalpin/mcp-rest-api"],
      "enabled": true,
      "environment": {
        "BASE_URL": "https://api.example.com/v1",
        "AUTH_BEARER": "{env:AUTH_BEARER}",
        "HEADER_Accept": "application/json"
      }
    }
  }
}
